# Copia este fichero a .env y rellena con los valores de tu proyecto Supabase
# (Supabase -> Project Settings -> API Keys)
#
# VITE_SUPABASE_ANON_KEY es la que la consola llama hoy "Publishable key"
# (empieza por sb_publishable_). Es PÚBLICA a propósito: quien protege los
# datos es el RLS del esquema. La "Secret key" (sb_secret_) NO va aquí nunca:
# se salta el RLS y viajaría dentro del paquete que se descarga el navegador.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
